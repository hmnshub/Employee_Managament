{
  "name": "employee-self-service-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mini Project 01 – Production-Ready Secure Employee Self-Service Portal",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server run start",
    "test": "npm --prefix server run test",
    "lint": "node --check server/src/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "express-rate-limit": "7.4.0",
    "helmet": "7.1.0",
    "pdfkit": "0.15.0",
    "zod": "3.23.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
