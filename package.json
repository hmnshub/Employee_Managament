{
  "name": "employee-self-service-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Mini Project 01 – Production-Ready Secure Employee Self-Service Portal",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server run start",
    "test": "npm --prefix server run test",
    "lint": "node --check server/src/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
