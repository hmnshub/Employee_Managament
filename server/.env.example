# =============================================================================
# Employee Self-Service Portal - Server Configuration (.env.example)
# Copy this file to server/.env and fill in ONLY the two Supabase values below.
# All other settings have safe production-grade defaults in src/config/index.js.
# Because session tokens are random 256-bit values stored as SHA-256 hashes in
# the database, NO session or JWT secret is required in .env.
# =============================================================================

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides (safe defaults are applied automatically if omitted):
# PORT=4000
# CLIENT_ORIGIN=http://localhost:5173
# NODE_ENV=development
# SESSION_TTL_HOURS=8
# SESSION_IDLE_MINUTES=30
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX_IP=20
# LOGIN_LOCKOUT_THRESHOLD=5
# LOGIN_LOCKOUT_MINUTES=15
