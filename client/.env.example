# =============================================================================
# Employee Self-Service Portal - Client Configuration (.env.example)
# The browser NEVER talks to Supabase directly. It only talks to the Node API.
# Leave VITE_API_BASE_URL empty in development to use the local proxy (/api),
# or set it to http://localhost:4000 if running on a separate origin.
# =============================================================================

VITE_API_BASE_URL=
